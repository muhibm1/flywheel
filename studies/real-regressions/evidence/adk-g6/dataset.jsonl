{"id": "structured_ticket", "inputs": {"agent": {"schema": "ticket", "instruction": "Classify the support message into the schema. Categories: billing, bug, feature."}, "messages": ["I was charged twice for my subscription this month, please fix it urgently."]}, "reference_outputs": {"json": {"category": "billing"}}, "metadata": {"source": "standing"}}
{"id": "session_memory_two_turns", "inputs": {"agent": {"tools": ["save_note", "get_note"], "instruction": "You keep notes for the user in session state with save_note and read them back with get_note."}, "messages": ["Save a note with key color and value teal.", "What is the value of my note called color? Use get_note."]}, "reference_outputs": {"finals_contain": [[], ["teal"]], "state_contains": {"note_color": "teal"}, "tools_called": ["save_note", "get_note"]}, "metadata": {"source": "standing"}}
