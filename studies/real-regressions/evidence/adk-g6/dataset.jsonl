{"id": "calc_two_step", "inputs": {"agent": {"tools": ["add", "multiply"], "instruction": "You do arithmetic with the add and multiply tools, one call per step. When you have the final number, state it and stop calling tools."}, "messages": ["What is (17 + 25) * 3? Use the tools for each step."]}, "reference_outputs": {"final_contains": ["126"], "tools_called": ["add", "multiply"]}, "metadata": {"source": "standing"}}
{"id": "weather_lookup", "inputs": {"agent": {"tools": ["get_weather"], "instruction": "You are a weather assistant. Always call get_weather before answering."}, "messages": ["What is the weather in Paris right now?"]}, "reference_outputs": {"final_contains": ["18"], "tools_called": ["get_weather"], "tool_args": [{"name": "get_weather", "args": {"city": "Paris"}}]}, "metadata": {"source": "standing"}}
{"id": "order_totals_sum", "inputs": {"agent": {"tools": ["lookup_order", "add"], "instruction": "You are an order assistant. Use lookup_order for every order and add for sums."}, "messages": ["Look up orders A100 and A200 and tell me their combined total."]}, "reference_outputs": {"final_contains": ["141.5"], "tools_called": ["lookup_order"]}, "metadata": {"source": "standing"}}
{"id": "file_sum_report", "inputs": {"agent": {"tools": ["read_file", "write_file", "add"], "instruction": "You are a file assistant working in a workspace. Use the file tools; do not guess file contents."}, "files": {"numbers.txt": "10\n20\n30\n"}, "messages": ["Read numbers.txt, add the numbers up, and write the total (just the number) to total.txt. Then tell me the total."]}, "reference_outputs": {"final_contains": ["60"], "files_contain": {"total.txt": ["60"]}, "tools_called": ["read_file", "write_file"]}, "metadata": {"source": "standing"}}
