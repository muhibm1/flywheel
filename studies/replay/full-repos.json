    ],
    "test_globs": [
      "test/**/*.test.mjs"
    ],
    "links": {
      "node_modules": "$ATELIER_NM"
    }
  },
  {
    "name": "lodestar",
    "path": "lodestar",
    "test_command": "\"$LODESTAR_PY\" -m pytest -q -x -p no:cacheprovider {tests}",
    "code_globs": [
      "src/**/*.py"
    ],
