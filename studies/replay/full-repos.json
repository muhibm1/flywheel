    ]
  },
  {
    "name": "auspex",
    "path": "auspex",
    "test_command": "node --test {tests}",
    "code_globs": [
      "src/**/*.js",
      "src/**/*.jsx",
      "bin/**/*.js"
    ],
    "test_globs": [
      "test/**/*.test.js"
    ],
    "links": {
      "node_modules": "$AUSPEX_NM"
    }
  },
  {
    "name": "atelier",
    "path": "atelier",
    "test_command": "node --test {tests}",
