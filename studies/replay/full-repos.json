    },
    "agent_path": "$LODESTAR_BIN"
  },
  {
    "name": "garvis",
    "path": "garvis",
    "test_command": "\"$GARVIS_PY\" -m pytest -q -x -p no:cacheprovider {tests}",
    "code_globs": [
      "src/**/*.py"
    ],
    "test_globs": [
      "tests/**/test_*.py"
    ],
    "env": {
